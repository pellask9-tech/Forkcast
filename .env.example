# Copy this file to .env.local and fill it in. .env.local is ignored by git, so your key stays private.

# Your Anthropic API key, from https://console.anthropic.com (Settings > API keys).
# Used only by the scan server (src/app/api/scan+api.ts). It never goes into the app itself.
ANTHROPIC_API_KEY=

# Optional: which Claude model reads the photos.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: set to 1 to test the scan screen without an API key.
# The server returns a sample result (rice, adobo, kangkong) instead of reading your photo.
# SCAN_DEMO=1

# Coaching. The app already uses Forkcast's Supabase project (src/config.ts). Set these only to use a
# different project (from its Project Settings > API), or set both empty to turn coaching off.
# Both values are public by design; the database rules in supabase/schema.sql keep data private.
# Never put the database password or a secret / service_role key here.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "image": "latest"
      }
    }
  }
}

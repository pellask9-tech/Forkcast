{
  "expo": {
    "name": "Forkcast",
    "slug": "forkcast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forkcast",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Forkcast uses the camera to scan your meals and estimate their nutrition.",
        "NSPhotoLibraryUsageDescription": "Forkcast lets you pick a meal photo to estimate its nutrition."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDF1EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDF1EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Forkcast uses the camera to scan your meals and estimate their nutrition.",
          "photosPermission": "Forkcast lets you pick a meal photo to estimate its nutrition."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
